# The only secret this project has.
.env
.env.local

# Refetchable. `python cli.py all` rebuilds every one of these from FRED,
# ALFRED, the Board's meeting calendar and the futures sources. ~25 MB of
# cached upstream responses does not belong in git.
engine/data/cache/

# Comparison artefacts: `--no-futures` writes these so the futures claim stays
# falsifiable in one command. They are outputs, not inputs.
# The same for every block toggle (--no-news, --no-text, ...): any tagged
# artefact is a comparison run, never a published one.
engine/data/matrix.*.json
engine/models/*.*.json

__pycache__/
*.pyc
*.log

node_modules/
.next/
.next-*/
*.tsbuildinfo
next-env.d.ts
